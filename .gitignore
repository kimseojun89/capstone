# ── Python ─────────────────────────────────────────────
**/.venv/
**/__pycache__/
*.pyc

# ── C++ 빌드 산출물 (재생성 가능) ───────────────────────
antidrone/cpp/build/
antidrone/cpp/build_win/

# ── 다운로드 SDK / 대용량 아카이브 ──────────────────────
onnxruntime-gpu/
*.zip

# ── 대용량 모델 가중치 (git 비추적; 별도 보관) ──────────
*.onnx
*.pt
*.bin

# ── 레거시 OpenVINO IR (272MB 블롭; 디스크 보관, git 제외) ─
legacy/best_openvino_model/

# ── Vivado 생성물 (소스: .xpr, .srcs/constrs·bd·hdl 만 추적) ──
antidrone/antidrone.cache/
antidrone/antidrone.hw/
antidrone/antidrone.sim/
antidrone/antidrone.ip_user_files/
antidrone/antidrone.gen/
vivado_project/*.cache/
vivado_project/*.hw/
vivado_project/*.sim/
vivado_project/*.ip_user_files/
vivado_project/*.runs/
vivado_project/*.gen/
vivado_project/*.ipdefs/
*.jou
*.log

# ── Vitis 플랫폼 (XSA에서 재생성; recreate_platform.tcl) ─
antidrone/vitis_workspace/antidrone_platform/

# ── Vitis 생성물 (소스만 추적) ──────────────────────────
antidrone/vitis_workspace/**/build/
antidrone/vitis_workspace/**/_ide/
antidrone/vitis_workspace/**/logs/
antidrone/logs/

# ── Vitis HLS 프로젝트 산출물 (.cpp 소스는 추적) ────────
Vitis/*_prj/

# ── 에디터 / IDE / 캐시 ─────────────────────────────────
**/.theia/
**/.cache/
**/.compile_commands/
.vscode/

# ── Xilinx 임시 작업 폴더 ───────────────────────────────
.Xil/
**/.Xil/

# ── Claude Code 런타임 (락/임시) ────────────────────────
.claude/scheduled_tasks.lock
.claude/*.lock

# ── 외부 다운로드 데이터셋 (386MB; 학습 이미지·산출물·영상) ─
scripts/Drone-Detection-YOLOv8x-main/

# ── 대용량 샘플 영상 (벤치마크 입력; 별도 보관) ─────────
*.mp4
*.avi
*.mov
